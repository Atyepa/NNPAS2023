# --- R session / project cruft ---
.Rhistory
.RData
.Rdata
.Ruserdata
.Rproj.user/
.rscignore

# --- Editor / assistant config ---
.claude/
*.local.json

# --- Local-only and backup copies (not for the repo) ---
old_*
*_original.R
*_local.R
Backup*/

# --- Large / regenerated data ---
# app_data.rds is a build artifact (prep_data.R makes it). Keep it OUT of Git
# if the repo feels heavy; shinyapps.io bundles your local copy at deploy time.
# Uncomment to ignore:
# app_data.rds

